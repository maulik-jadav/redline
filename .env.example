# Production setup: docs/DEPLOYMENT.md. Safe diagnostic: npm run check:production.
# Supabase configuration. Browser credentials grant no direct table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged credential. Never expose through NEXT_PUBLIC_* or browser imports.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Realtime: the project's trusted legacy HS256 JWT secret (32+ characters).
# Server-only. Must match Supabase's verifier; leave blank to use polling only.
SUPABASE_REALTIME_JWT_SECRET=

# Optional server-only AI: set AI_PROVIDER=anthropic and supply a key.
# Leave blank for a complete canonical game with deterministic fallback copy.
AI_PROVIDER=
AI_API_KEY=

# Optional Anthropic model override; defaults to claude-haiku-4-5.
AI_MODEL=
